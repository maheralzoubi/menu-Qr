GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="YOUR_APP_URL"

# MongoDB
MONGODB_URI="mongodb://localhost:27017/menu_qr"

# JWT
JWT_SECRET="change_this_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000

# Resend (transactional email: sign-in codes, owner verification, password reset).
# EMAIL_FROM must use a domain verified in Resend — onboarding@resend.dev only delivers to your own inbox.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="Menu Go <no-reply@your-verified-domain.com>"

# Restaurant chat assistant — set ONE of these (chat is hidden when neither is set).
# GEMINI_API_KEY (top of file) is free: https://aistudio.google.com/apikey
# GEMINI_MODEL="gemini-3.8-flash"
# ANTHROPIC_API_KEY is paid and takes priority if set.
# ANTHROPIC_API_KEY=""
